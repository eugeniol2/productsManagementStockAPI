POSTGRES_USER=stock
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=stock

DATABASE_URL=postgresql://stock:troque-me@localhost:5432/stock?schema=public

# Autenticação (JWT RS256). A API verifica os tokens com esta chave pública.
# Em produção vem do serviço de auth. Os testes (npm run test:integration) geram
# a própria chave e não precisam desta — ela só é necessária para o dev server.
JWT_PUBLIC_KEY=
